<?xml version="1.0" encoding="utf-8"?>
<!-- Résultat d'une opération en un seul écran : informations, avertissements et erreurs (au lieu d'une boîte de message chacune). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Résultat" Height="420" Width="900" MinHeight="260" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="Fermer" Content="Fermer" IsDefault="True" IsCancel="True" Style="{StaticResource BtnPrimary}" Width="110" Margin="0"/>
    </StackPanel>
    <TextBlock x:Name="Resume" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="Grille">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Gravité" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Text="{Binding Gravite}" Foreground="{Binding Couleur}" FontWeight="SemiBold" Margin="6,2" VerticalAlignment="Top"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Sujet" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Text="{Binding Sujet}" TextWrapping="Wrap" Margin="6,2" VerticalAlignment="Top"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Message" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="6,2" VerticalAlignment="Top"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
