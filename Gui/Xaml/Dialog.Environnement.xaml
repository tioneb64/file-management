<?xml version="1.0" encoding="utf-8"?>
<!-- Création ou modification d'un environnement. Le moteur revérifie tout avant l'écriture. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environnement" Height="560" Width="820" MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnOk" Content="Valider" IsDefault="True" Style="{StaticResource BtnPrimary}" Width="120"/>
      <Button x:Name="BtnAnnuler" Content="Annuler" IsCancel="True" Style="{StaticResource Btn}" Width="110" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="Intro" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#1F3A5F" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <CheckBox x:Name="DesactiverRegles" DockPanel.Dock="Bottom" Margin="0,4,0,0" IsChecked="True" Visibility="Collapsed"
              Content="Désactiver les règles copiées (recommandé : elles gardent les répertoires de l'original tant que vous ne les avez pas modifiés)"/>
    <CheckBox x:Name="CreerBase" DockPanel.Dock="Bottom" Margin="0,4,0,0" IsChecked="True"
              Content="Créer la base maintenant (nécessaire avant le premier lancement ; sans effet si elle existe déjà)"/>
    <TextBlock x:Name="Avis" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#6B4A00" Margin="0,6,0,0"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="Nom" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="minuscules, chiffres, _ et -" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Base (SQLite)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="Base" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="chemin local complet, ex. D:\Copie\production.db" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Dossier des journaux" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="DossierLogs" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="vide : « logs » à côté de la base" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Dossier de travail" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="DossierTravail" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="3" Grid.Column="2" Text="vide : « travail » à côté de la base" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Règles en parallèle" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="4" Grid.Column="1" x:Name="ParalleleMax" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="4" Grid.Column="2" Text="vide : défaut du moteur" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
      <TextBlock Grid.Row="5" Grid.Column="0" Text="Historique (jours)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="5" Grid.Column="1" x:Name="RetentionExecutions" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="5" Grid.Column="2" Text="vide : 365" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
      <TextBlock Grid.Row="6" Grid.Column="0" Text="Journaux (jours)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="6" Grid.Column="1" x:Name="RetentionJournaux" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="6" Grid.Column="2" Text="vide : pas de purge" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
      <TextBlock Grid.Row="7" Grid.Column="0" Text="Marge d'espace (Mo)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <TextBox Grid.Row="7" Grid.Column="1" x:Name="MargeEspaceMo" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="7" Grid.Column="2" Text="vide : 64" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,8"/>
    </Grid>
  </DockPanel>
</Window>
