<?xml version="1.0" encoding="utf-8"?>
<!-- Résultat de « Vérifier le paramétrage » : refus, avertissements et informations du moteur. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vérification du paramétrage" Height="460" Width="900" MinHeight="300" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="Fermer" Content="Fermer" IsDefault="True" IsCancel="True" Style="{StaticResource BtnPrimary}" Width="110" Margin="0"/>
    </StackPanel>
    <TextBlock x:Name="Resume" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="Grille">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Gravité" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Text="{Binding Gravite}" Foreground="{Binding Couleur}" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="60"/>
        <DataGridTextColumn Header="Règle" Binding="{Binding Regle}" Width="150"/>
        <DataGridTextColumn Header="Ligne" Binding="{Binding Ligne}" Width="55"/>
        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
