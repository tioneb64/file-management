<?xml version="1.0" encoding="utf-8"?>
<!-- Purge : liste de ce qui serait supprimé (journaux et archives). Rien n'est supprimé avant le clic sur « Purger ». -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purge des journaux et des archives" Height="480" Width="940" MinHeight="300" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnPurger" Content="Purger" Style="{StaticResource BtnDanger}" Width="130"/>
      <Button x:Name="BtnFermer" Content="Fermer sans purger" IsCancel="True" IsDefault="True" Style="{StaticResource Btn}" Width="170" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="Resume" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBlock x:Name="Remarques" DockPanel.Dock="Top" Foreground="#6B4A00" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="Grille">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
        <DataGridTextColumn Header="Règle" Binding="{Binding Regle}" Width="170"/>
        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110"/>
        <DataGridTextColumn Header="Taille" Binding="{Binding Taille}" Width="90"/>
        <DataGridTextColumn Header="Chemin" Binding="{Binding Chemin}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
