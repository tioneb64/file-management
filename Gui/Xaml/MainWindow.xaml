<?xml version="1.0" encoding="utf-8"?>
<!--
  Fenêtre principale (même maquette que l'outil de gestion du cluster Hyper-V : bandeau, onglets,
  journal, barre d'état). Un onglet par environnement ; chaque onglet est chargé depuis
  Environnement.xaml. Styles.xaml est référencé par un chemin relatif : le chargeur fournit le
  dossier Gui\Xaml\ comme BaseUri.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des transferts de fichiers" Height="860" Width="1380" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="5"/>
      <RowDefinition Height="150" MinHeight="60"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Bandeau -->
    <Border x:Name="HeaderBar" Grid.Row="0" Background="#1F3A5F" Padding="18,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock x:Name="TitleText" Text="Transferts de fichiers" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubTitleText" Text="Gestion du paramétrage" Foreground="#B8C7DA" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="UserText" Foreground="#B8C7DA" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Border x:Name="ModeBadge" CornerRadius="12" Padding="14,4" Margin="0,0,12,0" Background="#2E7D32">
            <TextBlock x:Name="ModeText" Text="ADMINISTRATEUR" Foreground="White" FontWeight="Bold"/>
          </Border>
          <Button x:Name="BtnRefresh" Content="Actualiser" Style="{StaticResource BtnHeader}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="1" Margin="12,12,12,6">
      <!-- Gestion des environnements (administrateurs) -->
      <WrapPanel x:Name="BarreEnvironnements" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
        <TextBlock Text="Environnements" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="BtnEnvNouveau" Content="Nouvel environnement…" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
        <Button x:Name="BtnEnvModifier" Content="Modifier / renommer…" Style="{StaticResource Btn}" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="BtnEnvCopier" Content="Copier vers un nouvel environnement…" Style="{StaticResource Btn}" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="BtnEnvBase" Content="Créer la base…" Style="{StaticResource Btn}" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="BtnEnvSupprimer" Content="Supprimer…" Style="{StaticResource BtnDanger}" Margin="0,0,8,0" IsEnabled="False"/>
      </WrapPanel>
      <Grid>
        <TabControl x:Name="Tabs" Background="#F3F5F8" BorderThickness="0"/>
        <!-- Aucun environnement affiché : on explique pourquoi et on propose d'en créer un. -->
        <Border x:Name="EtatVide" Visibility="Collapsed" Background="#F3F5F8" Padding="40">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
            <TextBlock x:Name="EtatVideTitre" FontSize="18" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="EtatVideTexte" TextWrapping="Wrap" Foreground="#2E3A48" Margin="0,0,0,16"/>
            <Button x:Name="BtnEtatVideCreer" Content="Créer un premier environnement…" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </Grid>
    </DockPanel>

    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#D5DCE5"/>

    <!-- Journal -->
    <Border Grid.Row="3" Background="#1E242C">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,6,12,2" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Text="Journal" Foreground="#B8C7DA" FontWeight="SemiBold"/>
          <Button x:Name="BtnLogClear" DockPanel.Dock="Right" Content="Effacer" Style="{StaticResource BtnHeader}" Padding="8,2" Margin="0"/>
        </DockPanel>
        <RichTextBox x:Name="LogBox" IsReadOnly="True" Background="#1E242C" Foreground="#DDE3EA" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="8,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <FlowDocument PageWidth="2600"/>
        </RichTextBox>
      </DockPanel>
    </Border>

    <!-- Barre d'état -->
    <Border Grid.Row="4" Background="#E4E9F0" Padding="12,4">
      <DockPanel>
        <TextBlock x:Name="LogPathText" DockPanel.Dock="Right" Foreground="#4A5868" FontSize="11"/>
        <TextBlock x:Name="StatusText" Text="Prêt" Foreground="#1F2D3D"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
