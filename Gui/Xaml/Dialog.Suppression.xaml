<?xml version="1.0" encoding="utf-8"?>
<!-- Suppression d'un environnement : second contrôle. Il faut saisir le nom exact et un commentaire. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supprimer un environnement" Height="400" Width="620" MinHeight="340" MinWidth="480"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnOk" Content="Supprimer" Style="{StaticResource BtnDanger}" Width="120" IsEnabled="False"/>
      <Button x:Name="BtnAnnuler" Content="Annuler" IsCancel="True" IsDefault="True" Style="{StaticResource Btn}" Width="110" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="Question" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#9A2A1F" Margin="0,0,0,8"/>
    <TextBlock x:Name="Consigne" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBox x:Name="Nom" DockPanel.Dock="Top" Margin="0,0,0,10"/>
    <TextBlock DockPanel.Dock="Top" Text="Pourquoi supprime-t-on cet environnement ?" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
    <TextBox x:Name="Commentaire" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  </DockPanel>
</Window>
