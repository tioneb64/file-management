<?xml version="1.0" encoding="utf-8"?>
<!--
  Onglet « Outils » : dossier des outils (réglage du moteur, commun à tous les environnements), liste des outils
  trouvés par le scan avec leur variable {outil:nom} et leurs paramètres. Chargé seul par le module Gui (une
  instance, après les onglets d'environnement) ; il fusionne Styles.xaml dans ses propres ressources.
-->
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Name="TabOutils" Header="Outils">
  <TabItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </TabItem.Resources>

  <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
      <RowDefinition Height="5"/>
      <RowDefinition Height="250" MinHeight="90"/>
    </Grid.RowDefinitions>

    <!-- Dossier des outils -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="Dossier des outils (réglage du moteur, commun à tous les environnements)"/>
        <DockPanel LastChildFill="True" Margin="0,0,0,6">
          <Button x:Name="BtnOutilsScanner" DockPanel.Dock="Right" Content="Enregistrer et scanner" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                  ToolTip="Enregistre le dossier, parcourt ce dossier et ses sous-dossiers et indexe les outils qui ont un en-tête valide. À refaire après chaque ajout, retrait ou déplacement d'un outil."/>
          <Button x:Name="BtnOutilsParcourir" DockPanel.Dock="Right" Content="Parcourir…" Style="{StaticResource Btn}" Margin="8,0,0,0"/>
          <TextBox x:Name="DossierOutils" VerticalContentAlignment="Center" Padding="4,4"
                   ToolTip="Vide : le dossier « outils » situé à la racine du moteur."/>
        </DockPanel>
        <TextBlock x:Name="InfoDossierOutils" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
        <TextBlock x:Name="InfoScanOutils" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- Recherche -->
    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock x:Name="CompteurOutils" VerticalAlignment="Center" Foreground="#4A5868" Margin="0,0,16,6"/>
      <TextBlock Text="Recherche" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBox x:Name="RechercheOutils" Width="260" Margin="0,0,14,6" ToolTip="Filtre sur la variable, le dossier, le fichier ou la description."/>
      <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,6"
                 Text="Dans la commande d'un programme, la variable doit être le premier élément du tableau : [&quot;{outil:nom}&quot;, &quot;--option&quot;, &quot;{liste}&quot;]."/>
    </WrapPanel>

    <DataGrid x:Name="GrilleOutils" Grid.Row="2">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="210">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="FontFamily" Value="Consolas"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Margin" Value="6,0"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Dossier" Binding="{Binding SousDossier}" Width="130"/>
        <DataGridTextColumn Header="Fichier" Binding="{Binding Fichier}" Width="200"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="Paramètres obligatoires" Binding="{Binding Obligatoires}" Width="220"/>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#D5DCE5"/>

    <!-- Détail de l'outil sélectionné -->
    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,8,0,0">
        <TextBlock x:Name="OutilTitre" Style="{StaticResource CardTitle}" Text="Aucun outil sélectionné"/>
        <TextBlock x:Name="OutilDescription" TextWrapping="Wrap" Foreground="#1F2D3D" Margin="0,0,0,6"/>
        <TextBlock x:Name="OutilFichier" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="À mettre dans la commande du programme" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="OutilExemple" IsReadOnly="True" FontFamily="Consolas" Padding="4,3" Margin="0,0,0,8"/>
        <DataGrid x:Name="GrilleParametres" MaxHeight="170">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Paramètre" Binding="{Binding Parametre}" Width="260"/>
            <DataGridTextColumn Header="Obligatoire" Binding="{Binding Obligatoire}" Width="90"/>
            <DataGridTextColumn Header="Rôle" Binding="{Binding Description}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</TabItem>
