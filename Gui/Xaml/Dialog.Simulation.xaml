<?xml version="1.0" encoding="utf-8"?>
<!-- Simulation d'une règle : ce que le moteur ferait maintenant. Rien n'est copié, déplacé ni enregistré. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulation d'une règle" Height="720" Width="1180" MinHeight="460" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnCreer" Content="Créer les dossiers manquants…" Style="{StaticResource BtnPrimary}" Width="230" Margin="0,0,8,0" Visibility="Collapsed"/>
      <Button x:Name="BtnFermer" Content="Fermer" IsCancel="True" IsDefault="True" Style="{StaticResource Btn}" Width="110"/>
    </StackPanel>
    <TextBlock x:Name="Resume" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock x:Name="Remarques" DockPanel.Dock="Top" Foreground="#6B4A00" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="Contrôles des répertoires" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
    <DataGrid x:Name="GrilleControles" DockPanel.Dock="Top" Height="150" Margin="0,0,0,10">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Répertoire" Binding="{Binding Role}" Width="150"/>
        <DataGridTextColumn Header="Chemin" Binding="{Binding Chemin}" Width="2*"/>
        <DataGridTextColumn Header="Existe" Binding="{Binding Existe}" Width="60"/>
        <DataGridTextColumn Header="Lecture" Binding="{Binding Lecture}" Width="65"/>
        <DataGridTextColumn Header="Écriture" Binding="{Binding Ecriture}" Width="150"/>
        <DataGridTextColumn Header="Espace disque" Binding="{Binding Espace}" Width="230"/>
        <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="80"/>
        <DataGridTextColumn Header="Remarque" Binding="{Binding Remarque}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock DockPanel.Dock="Top" Text="Fichiers concernés" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
    <DataGrid x:Name="Grille">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Fichier source" Binding="{Binding Fichier}" Width="2*"/>
        <DataGridTextColumn Header="Destination" Binding="{Binding Cible}" Width="2*"/>
        <DataGridTextColumn Header="Taille" Binding="{Binding Taille}" Width="90"/>
        <DataGridTextColumn Header="Archive" Binding="{Binding Archive}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
