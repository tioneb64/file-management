<?xml version="1.0" encoding="utf-8"?>
<!--
  Onglet d'un environnement : liste des règles (filtres), détail de la règle sélectionnée, état renvoyé
  par le moteur. Chargé seul par le module Gui (une instance par environnement) ; il fusionne
  Styles.xaml dans ses propres ressources (chemin relatif résolu par le BaseUri du chargeur).
-->
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Name="TabEnv" Header="Environnement">
  <TabItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Une carte : titre et lignes libellé / valeur (détail et état partagent ce modèle). -->
      <DataTemplate x:Key="Groupe">
        <Border Style="{StaticResource Card}" Width="470">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Titre}"/>
            <ItemsControl ItemsSource="{Binding Lignes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="190"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{Binding Libelle}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Valeur}" TextWrapping="Wrap" Foreground="#1F2D3D"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </TabItem.Resources>

  <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
      <RowDefinition Height="5"/>
      <RowDefinition Height="270" MinHeight="90"/>
    </Grid.RowDefinitions>

    <!-- Message d'environnement (lecture seule, fichier non pris en charge...) -->
    <Border x:Name="Bandeau" Grid.Row="0" Background="#FFF4E0" BorderBrush="#E6B35A" BorderThickness="1" CornerRadius="6"
            Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
      <TextBlock x:Name="BandeauTexte" TextWrapping="Wrap" Foreground="#6B4A00"/>
    </Border>

    <!-- Filtres et actions -->
    <StackPanel Grid.Row="1">
    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock x:Name="Compteur" VerticalAlignment="Center" Foreground="#4A5868" Margin="0,0,16,6"/>
      <TextBlock Text="Recherche" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBox x:Name="Recherche" Width="200" Margin="0,0,14,6"/>
      <TextBlock Text="Statut" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <ComboBox x:Name="FiltreStatut" Width="150" Margin="0,0,14,6"
                ToolTip="Dernier statut de la règle, ou sa situation du moment (EN_COURS, EN_ATTENTE, BLOQUEE). ATTENTE : règle de comptage dont les seuils ne sont pas atteints."/>
      <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <ComboBox x:Name="FiltreMode" Width="120" Margin="0,0,14,6"/>
      <TextBlock Text="Règles" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <ComboBox x:Name="FiltreActivite" Width="100" Margin="0,0,16,6" ToolTip="Toutes les règles, seulement les actives, ou seulement les inactives."/>
      <Button x:Name="BtnVerifier" Content="Vérifier le paramétrage" Style="{StaticResource BtnPrimary}" Margin="0,0,8,6"/>
      <Button x:Name="BtnAjouter" Content="Ajouter" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnDupliquer" Content="Dupliquer" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnModifier" Content="Modifier" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnActiver" Content="Désactiver" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnSupprimer" Content="Supprimer" Style="{StaticResource BtnDanger}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <TextBlock x:Name="InfoFichier" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="8,0,0,6"/>
    </WrapPanel>
    <!-- Actions d'exploitation (administrateurs) -->
    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
      <Button x:Name="BtnActualiser" Content="Actualiser l'état" Style="{StaticResource Btn}" Margin="0,0,16,6"/>
      <Button x:Name="BtnReprise" Content="Reprise" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnLancer" Content="Lancer maintenant" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnAcquitter" Content="Acquitter" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnDebloquer" Content="Débloquer" Style="{StaticResource BtnDanger}" Margin="0,0,16,6" Visibility="Collapsed"/>
      <Button x:Name="BtnTrancher" Content="Trancher…" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnPurger" Content="Purger…" Style="{StaticResource BtnDanger}" Margin="0,0,16,6" Visibility="Collapsed"/>
      <Button x:Name="BtnPromouvoir" Content="Promouvoir…" Style="{StaticResource Btn}" Margin="0,0,8,6" Visibility="Collapsed"/>
      <Button x:Name="BtnSimuler" Content="Simuler la règle…" Style="{StaticResource BtnPrimary}" Margin="0,0,8,6" IsEnabled="False"
              ToolTip="Montre ce que la règle ferait maintenant (combien de fichiers, de quel répertoire vers quel répertoire), sans rien copier ni déplacer."/>
      <Button x:Name="BtnHistorique" Content="Historique…" Style="{StaticResource Btn}" Margin="0,0,8,6"/>
    </WrapPanel>
    </StackPanel>

    <DataGrid x:Name="GrilleRegles" Grid.Row="2">
      <!-- Lignes : grise = règle inactive, rouge = en erreur, bleu ciel = sélectionnée (la sélection l'emporte). -->
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Aspect}" Value="inactive">
              <Setter Property="Background" Value="#E4E8ED"/>
              <Setter Property="Foreground" Value="#7B8794"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Aspect}" Value="erreur">
              <Setter Property="Background" Value="#F8D4D0"/>
              <Setter Property="Foreground" Value="#7A1F16"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#BFE3FF"/>
              <Setter Property="Foreground" Value="#10253F"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderBrush" Value="Transparent"/>
              <Setter Property="Foreground" Value="#10253F"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Règle" Binding="{Binding Id}" Width="190"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="95"/>
        <DataGridTextColumn Header="Source → cible" Binding="{Binding Chemins}" Width="*"/>
        <DataGridTextColumn Header="Planification" Binding="{Binding Planification}" Width="230"/>
        <DataGridTextColumn Header="Active" Binding="{Binding Actif}" Width="60"/>
        <DataGridTemplateColumn Header="Statut" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Text="{Binding Statut}" Foreground="{Binding StatutCouleur}" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Dernier lancement" Binding="{Binding DernierLancement}" Width="140"/>
        <DataGridTextColumn Header="Prochain créneau" Binding="{Binding ProchainCreneau}" Width="140"/>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#D5DCE5"/>

    <TabControl x:Name="Onglets" Grid.Row="4" Background="#F3F5F8" BorderThickness="0">
      <TabItem Header="Détail de la règle">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Detail" ItemTemplate="{StaticResource Groupe}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Dépendances">
        <DockPanel>
          <TextBlock x:Name="GrapheInfo" DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="4,8,0,0"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="Graphe" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="État">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Etat" ItemTemplate="{StaticResource Groupe}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</TabItem>
