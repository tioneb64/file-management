<?xml version="1.0" encoding="utf-8"?>
<!-- Historique des versions d'un fichier de paramétrage : qui, quand, pourquoi, et ce que chaque enregistrement a changé. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique des modifications" Height="560" Width="1100" MinHeight="360" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnFermer" Content="Fermer" IsCancel="True" IsDefault="True" Style="{StaticResource BtnPrimary}" Width="110"/>
    </StackPanel>
    <TextBlock x:Name="Resume" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="42*" MinWidth="240"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="58*" MinWidth="320"/>
      </Grid.ColumnDefinitions>
      <DataGrid x:Name="Versions" Grid.Column="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Date" Binding="{Binding DateTexte}" Width="140"/>
          <DataGridTextColumn Header="Compte" Binding="{Binding Compte}" Width="130"/>
          <DataGridTextColumn Header="Commentaire" Binding="{Binding Commentaire}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D5DCE5"/>
      <DockPanel Grid.Column="2">
        <TextBlock x:Name="Remarque" DockPanel.Dock="Top" Foreground="#6B4A00" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <DataGrid x:Name="Differences">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Règle" Binding="{Binding Regle}" Width="120"/>
            <DataGridTextColumn Header="Changement" Binding="{Binding Changement}" Width="90"/>
            <DataGridTextColumn Header="Champ" Binding="{Binding Champ}" Width="150"/>
            <DataGridTextColumn Header="Avant" Binding="{Binding Avant}" Width="*"/>
            <DataGridTextColumn Header="Après" Binding="{Binding Apres}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
