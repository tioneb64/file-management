<?xml version="1.0" encoding="utf-8"?>
<!-- Formulaire d'une règle : les onglets et leurs champs sont construits par le code (Views\Dialog.Regle.ps1)
     à partir du modèle fourni par le moteur. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Règle" Height="720" Width="900" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnOk" Content="Enregistrer…" IsDefault="True" Style="{StaticResource BtnPrimary}" Width="130"/>
      <Button x:Name="BtnAnnuler" Content="Annuler" IsCancel="True" Style="{StaticResource Btn}" Width="110" Margin="8,0,0,0"/>
    </StackPanel>
    <Border x:Name="BandeauErreur" DockPanel.Dock="Bottom" Background="#FDECEA" BorderBrush="#E0A39B" BorderThickness="1" CornerRadius="6"
            Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
      <TextBlock x:Name="TexteErreur" TextWrapping="Wrap" Foreground="#8E2A1E"/>
    </Border>
    <TextBlock x:Name="Intro" DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TabControl x:Name="Onglets" Background="White" TabStripPlacement="Left"/>
  </DockPanel>
</Window>
