<?xml version="1.0" encoding="utf-8"?>
<!-- Promotion d'une règle vers un autre environnement : choix de la cible et adaptation des chemins. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Promouvoir une règle" Height="560" Width="860" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnOk" Content="Continuer vers le formulaire…" IsDefault="True" Style="{StaticResource BtnPrimary}" Width="220"/>
      <Button x:Name="BtnAnnuler" Content="Annuler" IsCancel="True" Style="{StaticResource Btn}" Width="110" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="Titre" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Environnement cible" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,0,8"/>
      <ComboBox x:Name="Cible" Grid.Row="0" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="1" Text="Texte à remplacer" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,0,8"/>
      <TextBox x:Name="Chercher" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="2" Text="Remplacé par" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,0,8"/>
      <TextBox x:Name="Remplacer" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
               Text="Le remplacement (sans tenir compte de la casse, texte littéral) s'applique aux dossiers de la règle et aux éléments de la commande des programmes, par exemple \serveur-prod\ par \serveur-recette\. Vous pourrez tout revoir dans le formulaire."/>
    <TextBlock x:Name="Remarques" DockPanel.Dock="Bottom" Foreground="#6B4A00" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <DataGrid x:Name="Apercu">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Champ" Binding="{Binding Champ}" Width="190"/>
        <DataGridTextColumn Header="Avant" Binding="{Binding Avant}" Width="*"/>
        <DataGridTextColumn Header="Après" Binding="{Binding Apres}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
